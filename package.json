{
  "name": "scrynx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Scrynx — the screenshot app with a built-in capture manager (dashboard). Open-source, local-first.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielDiasK/scrynx.git"
  },
  "homepage": "https://github.com/DanielDiasK/scrynx",
  "keywords": [
    "screenshot",
    "capture",
    "desktop",
    "tauri",
    "open-source"
  ],
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:app": "cd apps/desktop && bunx tauri dev",
    "build:app": "cd apps/desktop && bunx tauri build",
    "dev:landing": "cd apps/landing && bun run dev",
    "dev:desktop": "cd apps/desktop && bun run dev",
    "build": "cd apps/landing && bun run build && cd ../desktop && bun run build",
    "build:landing": "cd apps/landing && bun run build",
    "build:desktop": "cd apps/desktop && bun run build",
    "tauri": "cd apps/desktop && bunx tauri",
    "bump": "node scripts/bump.mjs"
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
